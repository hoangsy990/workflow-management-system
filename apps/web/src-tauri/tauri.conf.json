{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkFlow Management System",
  "version": "0.1.0",
  "identifier": "com.workflow.management",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WorkFlow Management System",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Quản lý công việc và quy trình phê duyệt nội bộ",
    "longDescription": "WorkFlow Management System dùng chung backend API cho web, Windows, Android và iOS."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "{{TAURI_UPDATE_ENDPOINT}}"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}

